
;    process interface for the kernel.
;    josiah bergen, may 2026
;
;    this file contains implentations for the following system calls:
;
;    | name   | args          | returns                                      | notes                                  |
;    | ------ | ------------- | -------------------------------------------- | -------------------------------------- |
;    | `exit` | b = exit code | a = exit code                                | exit the current process to the shell. |
;    | `exec` | b = string    | a = error (return not guaranteed on success) | load and execute file from disk.       |

sc_exit:
    ; this subroutine purges the entire call stack,
    ; re-enables interrupts, and transfers control back
    ; to the shell.

    pop z 
    cmp sp, stack_top
    ; since we can be anywhere in the call stack when this
    ; syscall executes, we need to keep popping until we get
    ; to the very top.
    jnz sc_exit

    ; move requested exit code into a,
    ; and transfer control back to the shell.
    mov a, b
    jmp shell__process_exited


sc_exec:
    ; TODO: depends on fs_* syscalls to work.
    ; this syscall will call fs_open -> fs_read -> fs_close,
    ; then construct stack frame and transfer.

    ; remove the current return address from the stack,
    ; because this function does not return.
    pop z

    ; for now, just use a hard-coded stack frame, etc.
    push 0x7000   ; target pc
    push 0xAFFF   ; target sp
    push 0x0000   ; target flags
    push 0x0000   ; target mb
    push 0x0001   ; target mode

    ; event kind & detail
    ; not used by transfer, but required by the stack frame
    push 0xFFFF 
    push 0xFFFF   
    transfer
