; this code lives at 0x100, and will eventually be in a separate file,
; and loaded into memory by the bootloader. for now, the emulator loads it to ram manually.

hardware_entry:

    ; this is the hardware-specified kernel entry point.
    ; interrupts, faults, and syscalls will all jump to here (0x0100).

    ; jump to the main dispatch code to make sense of what's going on.
    jmp event_dispatch
    
    ; ensure that the kernel initialization code below is aligned to a 
    ; 16-word boundary (0x0110, in this case). purely for aesthetics!
    align 0x10

init:
    ; bootloader jumps here (0x0110). perform a few small 
    ; initialization tasks and then jump to the shell.
    jmp shell__init
    
import "kernel/src/defs.jasm"
import "kernel/src/macros.jasm"
import "kernel/src/tty.jasm"
import "kernel/src/shell.jasm"

import "kernel/syscalls/process.jasm"
import "kernel/syscalls/output.jasm"
import "kernel/syscalls/input.jasm"
import "kernel/syscalls/fs.jasm"
import "kernel/syscalls/time.jasm"
import "kernel/syscalls/system.jasm"

import "kernel/lib/string.jasm"

; hardware event dispatch
; called via:  hardware interrupt, fault, or syscall
; returns:     nothing
;
; event_dispatch is passed a stack frame with this information:
; 
;    | offset | field      |
;    | ------ | ---------- |
;    | sp + 0 | event kind |
;    | .. + 1 | detail     |
;    | .. + 2 | mode       |
;    | .. + 3 | mb         |
;    | .. + 4 | flags      |
;    | .. + 5 | target sp  |
;    | .. + 6 | target pc  |

event_dispatch:
    pop x ; event kind

    ; parse what event we are dealing with and
    ; jump to the appropriate handler
    add x, ev_jump_table
    get z, [x]
    pop x ; prepare event detail in x before calling handler
    call z

    push 0x3A33  ; add a random kind and detail
    push 0x3A33  ; not used by transfer, but required by the stack frame
    transfer

dispatch_fault:
    ; todo: kill process, drop into kernel shell
    ; for now, just kill everything because we don't have a proper
    ; error handling mechanism yet.
    break
    ret 

dispatch_interrupt:
    ; event detail (interrupt number) is in x already
    mov z, int_jump_table
    add z, x ; compute the address of the interrupt handler

    get z, [z]
    cmp z, 0x0000 ; invalid interrupt addresses are zeroes in memory
    jz interrupt_not_found

    call z ; execute!
    ret

interrupt_not_found:
    mov a, 0x01
    ret ; return with error

dispatch_syscall:
    ; event detail (syscall number) is in x already

    mov z, sc_jump_table
    add z, x 

    get z, [z]
    cmp z, 0x0000 ; invalid syscall addresses are zeroes in memory
    jz syscall_not_found

    call z ; execute!
    ret ; we trust that the handler has set a value in a for us

syscall_not_found:
    mov a, 0x01
    ret ; exit with error

ev_jump_table:
    data dispatch_fault
    data dispatch_interrupt
    data dispatch_syscall

int_jump_table:
    data 0x00
    data 0x00
    data 0x00
    data 0x00
    data input__keyboard_interrupt  ; 0x04

    align 0x10
sc_jump_table:

    ; process
    data process__sc_exit        ; 0x00
    data process__sc_exec        ; 0x01
    align 0x10

    ; tty output
    data output__sc_write_str    ; 0x10
    data output__sc_write_char   ; 0x11
    data output__sc_clear        ; 0x12
    data output__sc_set_cursor   ; 0x13
    data output__sc_get_cursor   ; 0x14
    data output__sc_put_char_at  ; 0x15
    data output__sc_set_attr     ; 0x16
    align 0x10

    ; tty input (blocking)
    data input__sc_read_char     ; 0x20
    data input__sc_read_line     ; 0x21
    align 0x10

    ; filesystem
    data fs__sc_mount            ; 0x30
    data fs__sc_list             ; 0x31
    data fs__sc_open             ; 0x32
    data fs__sc_read             ; 0x33
    data fs__sc_write            ; 0x34
    data fs__sc_seek             ; 0x35
    data fs__sc_close            ; 0x36
    data fs__sc_stat             ; 0x37
    align 0x10

    ; time
    data time__sc_get_ticks      ; 0x40
    data time__sc_get_date       ; 0x41
    data time__sc_get_time       ; 0x42
    align 0x10

    ; system
    data system__sc_shutdown     ; 0x50
    data system__sc_reset        ; 0x51

align 0x7000

import "kernel/programs/graphics.jasm"