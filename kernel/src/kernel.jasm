; this code lives at 0x100, and will eventually be in a separate file,
; and loaded into memory by the bootloader. for now, the emulator loads it to ram manually.

hardware_entry:

    ; this is the hardware-specified kernel entry point.
    ; interrupts, faults, and syscalls will all jump to here (0x0100).

    ; jump to the main dispatch code to make sense of what's going on.
    jmp event_dispatch
    
    ; ensure that the kernel initialization code below is aligned to a 
    ; 16-word boundary (0x0110, in this case). purely for aesthetics!
    align 0x10

boot_entry:

    ; bootloader jumps here (0x0110). forward down to real kernel entry below,
    ; because we need to load all the defs and other stuff first.
    ; the actual kernel code is much further down in the binary.
    jmp init

import "kernel/src/defs.jasm"
import "kernel/src/macros.jasm"
import "kernel/src/tty.jasm"

import "kernel/syscalls/process.jasm"
import "kernel/syscalls/output.jasm"
import "kernel/syscalls/input.jasm"
import "kernel/syscalls/fs.jasm"
import "kernel/syscalls/time.jasm"
import "kernel/syscalls/system.jasm"

import "kernel/lib/string.jasm"

; small one-time initialization.
; the bootloader jumps to this code directly on startup.
init:
    call tty__init
    call shell__draw_startup_message

    mov x, 0
    mov y, 0
    call shell__draw_prompt_no_scroll

loop:
    wait
    jmp loop

; hardware event dispatch
; called via:  hardware interrupt, fault, or syscall
; returns:     nothing
;
; event_dispatch is passed a stack frame with this information:
; 
;    | offset | field      |
;    | ------ | ---------- |
;    | 0      | event kind |
;    | 1      | detail     |
;    | 2      | mode       |
;    | 3      | mb         |
;    | 4      | flags      |
;    | 5      | target sp  |
;    | 6      | target pc  |

event_dispatch:

    pop a ; event kind
    pop b ; event detail

    ; parse what event we are dealing with and
    ; jump to the appropriate handler
    add a, event_dispatch_table
    get y, [a]
    call y

event_dispatch_table:
    data dispatch_fault
    data dispatch_interrupt
    data dispatch_syscall

dispatch_fault:
    ; todo: kill process, drop into kernel shell
    ; for now, just kill everything because we don't have a proper
    ; error handling mechanism yet.
    halt 

dispatch_interrupt:
    ; 

; system call interface
; called via:  call kernel__dispatch_syscall  (a = syscall number, args in b, c, d, e)
; returns:     a = result (zero if success, nonzero if error)
dispatch_syscall:
    debug "at syscall handler: {b}"
    push y
    push z

    ; we have a number in b, which should map to an entry in the function table
    ; move to the start of the function table
    mov z, sc_function_table

syscall_search_loop:

    ; TODO: once a stable abi gets defined, just use an
    ;       actual jump table to avoid the loop here

    ; repeatedly search for our entry in the table
    get y, [z]
    cmp y, b             ; did we find a match?
    jz syscall_found     ; yes!

    cmp y, 0xFFFF        ; end of table?
    jz syscall_not_found ; yes, exit with error

    ; move to the next entry
    add z, 2
    jmp syscall_search_loop

syscall_not_found:
    mov a, 0x01
    jmp syscall_done

syscall_found:
    inc z ; move to the function pointer
    get y, [z]
    call y ; execute handler

syscall_done:
    pop z
    pop y
    ret ; we trust that the handler has set a value in a for us


sc_function_table:

    ; process
    data 0x00, process__sc_exit
    data 0x01, process__sc_exec
    ; tty output
    data 0x10, output__sc_write_str
    data 0x11, output__sc_write_char
    data 0x12, output__sc_clear
    data 0x13, output__sc_set_cursor
    data 0x14, output__sc_get_cursor
    data 0x15, output__sc_put_char_at
    data 0x16, output__sc_set_attr
    ; tty input (blocking)
    data 0x20, input__sc_read_char
    data 0x21, input__sc_read_line
    ; filesystem
    data 0x30, fs__sc_mount
    data 0x31, fs__sc_list
    data 0x32, fs__sc_open
    data 0x33, fs__sc_read
    data 0x34, fs__sc_write
    data 0x35, fs__sc_seek
    data 0x36, fs__sc_close
    data 0x37, fs__sc_stat
    ; time
    data 0x40, time__sc_get_ticks
    data 0x41, time__sc_get_date
    data 0x41, time__sc_get_time
    ; system
    data 0x50, system__sc_shutdown
    data 0x51, system__sc_reset
    data 0xFFFF  ; end of table

; all the shell interface code lives here.
import "kernel/src/shell.jasm"
