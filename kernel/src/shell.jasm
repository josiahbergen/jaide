;    kernel shell.
;    a prompt, a line buffer, and key echo.
;
;    public interface:
;
;    | name | args | returns         |
;    | ---- | ---- | --------------- |
;    | run  | -    | does not return |

run:
    ; draw the initial prompt
    call prompt

run_loop:
    call input__sc_poll_key
    cmp a, 0
    jz run_wait
    call handle_key
    jmp run_loop

run_wait:
    ; sleep until the next interrupt (e.g. a key press) arrives.
    wait
    jmp run_loop

prompt:
    ; empty the line buffer and draw the prompt at the cursor.
    save_to shell_line_length, 0
    mov b, s_prompt
    call tty__write
    ret

; handle one key.
;   a = key code
handle_key:
    ; enter and backspace get special cases
    cmp a, 0x0d 
    jz handle_key_enter
    cmp a, 0x08 
    jz handle_key_backspace

    ; ignore control characters and non-ascii keys
    ; (i.e. < 0x20 or >= 0x7f)
    cmp a, 0x20
    jb handle_key_done
    cmp a, 0x7f
    jae handle_key_done

    dereference_into c, shell_line_length
    cmp c, shell_line_capacity
    jae handle_key_done ; buffer is full, abort

    ; append the character to the buffer
    mov x, shell_line_buffer
    add x, c
    put [x], a
    inc c
    save_to shell_line_length, c

    ; echo the character
    mov b, a
    call tty__putc
    ret

handle_key_backspace:
    dereference_into c, shell_line_length
    cmp c, 0
    jz handle_key_done ; buffer is empty
    dec c
    save_to shell_line_length, c

    ; the prompt and a full buffer fit on one row, so the previous
    ; character is always directly left of the cursor.
    call tty__get_cursor ; b = column, c = row
    dec b
    call tty__set_cursor
    mov d, c
    mov c, b
    mov b, 0x20
    call tty__put_char_at
    ret

handle_key_enter:
    call tty__newline
    call prompt

handle_key_done:
    ret

s_prompt: data "$ ", 0
