;    kernel shell.
;    a prompt, a line buffer, and key echo.
;
;    public interface:
;
;    | name | args | returns         |
;    | ---- | ---- | --------------- |
;    | run  | -    | does not return |

run:
    ; draw the initial prompt
    call prompt
run_loop:
    ; main shell loop.
    call input__sc_read_char  ; wait for a key press (returned in a)
    call handle_keystroke     ; handle
    jmp run_loop              ; repeat

prompt:
    ; empty the line buffer and draw the prompt at the cursor.
    save_to shell_line_length, 0
    mov b, s_prompt
    call tty__write
    call tty__show_cursor
    ret

process_exited:
    call tty__reset
    mov b, s_process_exited
    call tty__write
    mov b, a
    add b, 0x30 ; convert single-digit number to ascii
    call tty__putc
    call tty__newline
    jmp run

; handle one keystroke.
;   a = key code
handle_keystroke:
    ; enter and backspace get special cases
    cmp a, 0x0d 
    jz handle_key_enter
    cmp a, 0x08 
    jz handle_key_backspace

    ; ignore control characters and non-ascii keys
    ; (i.e. < 0x20 or >= 0x7f)
    cmp a, 0x20
    jb handle_key_abort
    cmp a, 0x7f
    jae handle_key_abort

    dereference_into c, shell_line_length
    cmp c, shell_line_capacity
    jae handle_key_abort ; buffer is full, abort

    ; append the character to the buffer
    mov x, shell_line_buffer
    add x, c
    put [x], a
    inc c
    save_to shell_line_length, c

    mov b, a
    call tty__putc         ; echo the character,
    call tty__show_cursor  ; and redraw the new cursor position
    ret

handle_key_backspace:
    dereference_into c, shell_line_length
    cmp c, 0
    jz handle_key_abort ; buffer is empty
    dec c
    save_to shell_line_length, c

    ; the prompt and a full buffer fit on one row, so the previous
    ; character is always directly left of the cursor.
    ; erase the cursor, step back, and draw it over the deleted character.
    call tty__hide_cursor
    call tty__get_cursor ; b = column, c = row
    dec b
    call tty__set_cursor
    call tty__show_cursor
    ret

handle_key_enter:
    dereference_into c, shell_line_length
    cmp c, 0x00
    jz dispatch_command__empty ; buffer is empty

    ; we need to add a null terminator to wherever we are at the line buffer,
    ; because the string functions expect a null terminator and might have stale
    ; data still in there.
    add c, shell_line_buffer
    put [c], 0x00

    ; proceed with normal command dispatch.
    call tty__hide_cursor
    call tty__newline
    call dispatch_command
    call prompt

handle_key_abort:
    ret

dispatch_command:
    mov a, shell_line_buffer
    mov d, command_list

dispatch_command__loop:
    get b, [d] ; string pointer of the command we are checking
    cmp b, 0
    jz dispatch_command__not_found ; end of list, no match found

    call string__string_compare ; result in c (0 = equal); clobbers x, y
    cmp c, 0
    jz dispatch_command__found

    add d, 2 ; next entry (two words)
    jmp dispatch_command__loop

dispatch_command__found:
    ; match found! c has the string pointer of the matching command,
    ; so the next word is the function pointer
    inc d
    get b, [d] ; now b has the function pointer
    call b ; finally, call!
    ret 

dispatch_command__empty:
    call tty__hide_cursor
    call tty__newline
    call prompt
    ret

dispatch_command__not_found:
    mov b, s_invalid_command
    call tty__write
    ret

handler_exec:
    call tty__reset
    ; construct a stack frame to user mode,
    ; and transfer control to the user program.
    push 0x7000   ; target pc
    push 0xAFFF   ; target sp
    push 0x0000   ; target flags
    push 0x0000   ; target mb
    push 0x0001   ; target mode
    push 0x0000   ; event kind
    push 0x0000   ; event detail
    transfer

handler_clear:
    call tty__clear
    ret

handler_help:
    mov b, s_help_message
    call tty__write
    ret

handler_exit:
    ret

s_prompt:           data "$ ",                                         0
s_help_message:     data "exec:   execute the loaded program",   0xA
                    data "clear:  clear the screen",             0xA
                    data "help:   show this message",            0xA
                    data "exit:   shutdown the system",          0xA,  0

s_invalid_command:  data "invalid command.",                     0xA,  0
s_process_exited:   data "process exited with status ",                0
s_startup_message:  data "ready.",                               0xA
                    data "kernel shell v0.0.2",                  0xA
                    data "type 'help' for a list of commands.",  0xA,  0

s_cmd_exec:         data "exec",                                       0
s_cmd_clear:        data "clear",                                      0
s_cmd_help:         data "help",                                       0
s_cmd_exit:         data "exit",                                       0

command_list:
    ; maps string pointers to function pointers
    data s_cmd_exec,      handler_exec
    data s_cmd_clear,     handler_clear
    data s_cmd_help,      handler_help
    data s_cmd_exit,      handler_exit
    data 0,               0 ; end of list
