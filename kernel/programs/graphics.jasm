start:
    mov b, 0b0000000011100001  ; white on teal
    mov a, 0x12                ; sc_clear
    syscall

    mov a, 0x16                ; sc_set_attr
    mov b, 0b0000000001111111  ; magenta on dark magenta
    syscall

    mov b, s_welcome
    mov a, 0x10                ; sc_write_str
    syscall

    mov b, s_name
    mov a, 0x10                ; sc_write_str
    syscall

    ; wait for a key press
    mov a, 0x20 ; sc_read_char
    syscall

    mov a, 0x00 ; sc_exit
    mov b, 0x00 ; status code
    syscall

s_welcome: 
    data "jaide computing system",   0x0A,  0
s_name:
    data "created by josiah bergen", 0x0A,  0
